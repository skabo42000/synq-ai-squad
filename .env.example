# Template - the real keys go in .env (not committed)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Tracing (optional): see every step of a run at smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=synq-ai-squad

# Secret key that callers of the squad web endpoint must send (header: X-API-Key)
SQUAD_API_KEY=
